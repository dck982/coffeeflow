.env
*.env
.DS_Store
print/build/
__pycache__/
*.py[cod]
.pytest_cache/
tmp/
calibration/
captures/
configs/

# ESP-IDF build artefacts et config générée localement — voir
# firmware/IDF_VERSION.md pour la version figée.
archive/firmware/*/build/
archive/firmware/*/build-*/
archive/firmware/*/sdkconfig
archive/firmware/*/managed_components/
archive/firmware/*/dependencies.lock

# Généré depuis firmware/rust/protocol/log_codes.yaml, jamais commité.
archive/firmware/common/generated/

# Config locale déposée par `eim` (ESP-IDF Installation Manager).
eim_config.toml

# Cache clangd local (index par projet ESP-IDF).
archive/firmware/*/.cache/

# Secrets locaux de l'écran : ne jamais versionner le mot de passe WPA de
# l'AP de provisioning ni le jeton HTTP.
archive/firmware/screen/main/secrets.h
firmware/rust/screen/secrets.rs

# Cargo
target/
firmware/*/build/
firmware/*/build-*/
firmware/*/sdkconfig
firmware/*/managed_components/
firmware/*/dependencies.lock
firmware/*/.cache/
