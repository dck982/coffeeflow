         <pdf:Producer>Acrobat Distiller 22.0 (Windows)</pdf:Producer>
         <pdf:Keywords/>
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">MOC3052M - 6-Pin DIP Random-Phase Triac Driver Optocoupler (600 Volt Peak)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>onsemi</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The MOC3051M, MOC3052M and MOC3053M consist of a GaAs&#xA;infrared emitting diode optically coupled to a nonâˆ’zeroâˆ’ crossing&#xA;silicon bilateral AC switch (triac). These devices isolate low voltage&#xA;logic from 115 VAC and 240 VAC lines to provide random phase&#xA;control of high current triacs or thyristors. These devices feature&#xA;greatly enhanced static dv/dt capability to ensure stable switching&#xA;performance of inductive loads.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <xmpMM:DocumentID>uuid:3ddcb354-8785-4b62-a0fc-00f460b09293</xmpMM:DocumentID>
         <xmpMM:InstanceID>uuid:44c6554c-f0ef-4e32-919c-7fde66b6cce6</xmpMM:InstanceID>
      </rdf:Description>
   </rdf:RDF>
