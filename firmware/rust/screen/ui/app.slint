import "fonts/Inter-24pt-Regular.ttf";
import { Theme } from "theme.slint";

export struct Tile { name: string, value: string, detail: string, aside: string, enabled: bool, tone: int }
export struct Segment { x: float, width: float, name: string, value: string, tone: int, active: bool }

component Label inherits Text {
    color: Theme.text;
    font-size: 26px;
    vertical-alignment: center;
    overflow: elide;
}
component Key inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <bool> destructive: false;
    in property <int> icon: 0;
    in property <length> content-size: 26px;
    in property <bool> selected-toggle: false;
    callback clicked();
    callback held(bool);
    border-radius: 8px;
    background: !enabled ? Theme.raised : touch.pressed ? Theme.high : selected-toggle ? Theme.success : primary ? Theme.primary : Theme.surface;
    Label { text: root.label; font-size: root.content-size; color: root.selected-toggle ? Theme.bg : !root.enabled ? Theme.faint : root.destructive ? Theme.fault : root.primary ? Theme.accent : Theme.text; horizontal-alignment: center; x: root.icon != 0 ? 32px : 0px; width: parent.width - self.x; }
    // Un même jeu de tracés remplace les glyphes absents du sous-ensemble Inter.
    if root.icon == 1: Path { x: 18px; y: (parent.height - 32px) / 2; width: 32px; height: 32px; stroke: Theme.accent; stroke-width: 2px; fill: transparent; commands: "M 2 5 L 24 5 L 24 21 Q 24 29 13 29 Q 2 29 2 21 Z M 24 9 L 29 9 Q 34 16 24 19"; }
    if root.icon == 2: Path { x: 18px; y: (parent.height - 32px) / 2; width: 32px; height: 32px; stroke: Theme.full; stroke-width: 2px; fill: transparent; commands: "M 16 1 Q 2 17 3 23 Q 5 32 16 32 Q 27 32 29 23 Q 30 17 16 1 Z"; }
    if root.icon == 3: Path { x: 18px; y: (parent.height - 32px) / 2; width: 32px; height: 32px; stroke: Theme.dim; stroke-width: 2px; fill: transparent; commands: "M 0 7 L 32 7 M 0 16 L 32 16 M 0 25 L 32 25 M 10 2 L 10 12 M 23 11 L 23 21 M 14 20 L 14 30"; }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } pointer-event(event) => { if event.kind == PointerEventKind.down { root.held(true); } if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { root.held(false); } } }
}
component Back inherits Key {
    Path { x: 30px; y: 26px; width: 20px; height: 28px; stroke: Theme.text; stroke-width: 3px; fill: transparent; commands: "M 18 0 L 2 14 L 18 28"; }
}

export component AppWindow inherits Window {
    width: 800px; height: 480px;
    background: Theme.bg;
    default-font-family: "Inter 24pt";
    // Les unités et accents des chaînes calculées en Rust doivent aussi
    // exister dans les glyphes embarqués, même sans libellé Slint statique.
    Text { x: -200px; y: -200px; width: 1px; height: 1px; opacity: 0; text: "°µéèêëàâäçîïôöùûüÿœæÉÈÀÇŒ"; font-size: 18px; }
    // La présentation n'envoie jamais de commande matérielle directement.
    callback command(int, string);
    in property <int> page: 0;
    in property <int> settings-page: 0;
    in property <string> target: "36,0 g";
    in property <string> brew-label: "infuser · 36 g";
    in property <bool> brew-enabled: false;
    in property <bool> minus-enabled: true;
    in property <bool> plus-enabled: true;
    in property <string> warning;
    in property <string> detail;
    in property <string> clock: "-";
    in property <string> weight;
    in property <string> pressure: "-";
    in property <string> temperature: "-";
    in property <color> temperature-color: Theme.faint;
    in property <float> heating: 0;
    in property <bool> wifi-enabled: true;
    in property <bool> wifi-connected: false;
    in property <[Tile]> settings;
    in property <[Tile]> diagnostics;
    in property <[Tile]> brew-values;
    in property <[Tile]> live-values;
    in property <[Segment]> segments;
    in property <bool> reserve-visible: false;
    in property <float> reserve-x;
    in property <string> phase;
    in property <string> started;
    in property <bool> finished: false;
    in property <bool> close-enabled: true;
    in property <string> close-label: "fermer";
    in property <string> purge-time;
    in property <string> purge-detail;
    in property <bool> legacy-split: false;
    in property <string> legacy-time;
    in property <float> progress;
    in property <string> editor-title;
    in property <string> editor-value;
    in property <string> editor-unit;
    in property <bool> editor-decimal: true;
    in property <string> editor-error;
    in property <[Tile]> choices;
    in property <string> menu-title;
    in property <string> menu-body;
    in property <string> menu-hint;
    in property <string> menu-left;
    in property <string> menu-right;
    in property <bool> menu-left-enabled: true;
    in property <bool> menu-right-enabled: true;
    in property <bool> menu-left-destructive: false;
    in property <string> confirm-title;
    in property <string> confirm-body;
    in property <bool> confirm-visible: false;
    in property <string> full-title;
    in property <string> full-body;
    in property <bool> full-visible: false;
    in property <bool> full-fault: false;
    in property <bool> full-progress: false;
    in property <bool> dimmed: false;
    in property <bool> standby: false;
    in property <int> standby-offset: 0;

    if root.page == 0 || root.page == 1 || root.page == 2: Rectangle {
        x: 32px; y: 24px; width: 736px; height: 52px; background: transparent;
        Label { x: 40px; width: 82px; text: root.clock; color: Theme.dim; font-size: 28px; }
        Label { x: 142px; width: 104px; text: "v0.4.00"; font-size: 28px; }
        Rectangle { x: 132px; y: 12px; width: 1px; height: 28px; background: Theme.hairline; }
        Rectangle { x: 260px; y: 12px; width: 1px; height: 28px; background: Theme.hairline; }
        Label { x: 270px; width: 184px; text: root.weight; color: Theme.dim; font-size: 28px; horizontal-alignment: right; }
        Label { x: 470px; width: 110px; text: root.pressure; color: Theme.dim; font-size: 28px; horizontal-alignment: right; }
        Label { x: 626px; width: 110px; text: root.temperature; color: root.temperature-color; font-size: 28px; horizontal-alignment: right; }
        Rectangle { x: 606px; y: 12px; width: 1px; height: 28px; background: Theme.hairline; }
        Rectangle { x: 656px; y: 48px; width: 80px; height: 4px; background: Theme.raised; Rectangle { width: parent.width * root.heating; height: 4px; background: root.temperature-color; } }
        Path { x: 0px; y: 16px; width: 24px; height: 24px; stroke: Theme.dim; stroke-width: 2px; fill: transparent; commands: "M 2 20 L 2 10 M 10 20 L 10 2 M 18 20 L 18 14 M 0 20 L 22 20"; }
        TouchArea { x: 0px; y: -24px; width: 132px; height: 80px; clicked => { root.command(4, ""); } }
    }
    if root.page == 0: Rectangle {
        background: transparent;
        Label { y: 112px; height: 96px; width: 800px; font-size: 76px; text: root.target; horizontal-alignment: center; }
        TouchArea { x: 256px; y: 112px; width: 288px; height: 96px; clicked => { root.command(5, ""); } }
        Key { x: 256px; y: 216px; width: 136px; height: 80px; label: "−"; content-size: 40px; enabled: root.minus-enabled; clicked => { root.command(6, ""); } }
        Key { x: 408px; y: 216px; width: 136px; height: 80px; label: "+"; content-size: 40px; enabled: root.plus-enabled; clicked => { root.command(7, ""); } }
        Label { y: 312px; height: 24px; width: 800px; font-size: 18px; text: root.detail; color: Theme.faint; horizontal-alignment: center; }
        Label { y: 336px; height: 24px; width: 800px; font-size: 18px; text: root.warning; color: Theme.fault; horizontal-alignment: center; }
        Key { x: 32px; y: 368px; width: 288px; height: 88px; primary: true; icon: 1; label: root.brew-label; enabled: root.brew-enabled; clicked => { root.command(1, ""); } }
        Key { x: 336px; y: 368px; width: 200px; height: 88px; icon: 2; label: "purge"; held(down) => { root.command(down ? 2 : 3, ""); } }
        Key { x: 552px; y: 368px; width: 216px; height: 88px; icon: 3; label: "réglages"; clicked => { root.command(8, ""); } }
    }
    if root.page == 1: Rectangle {
        background: transparent;
        Label { x: 32px; y: 84px; width: 420px; height: 30px; text: root.phase; font-size: 18px; color: Theme.accent; }
        Label { x: 468px; y: 84px; width: 300px; height: 30px; text: root.started; font-size: 18px; horizontal-alignment: right; color: Theme.faint; }
        if root.reserve-visible: Rectangle { x: 32px + root.reserve-x * 1px; y: 122px; width: (736 - root.reserve-x) * 1px; height: 26px; border-width: 2px; border-color: Theme.faint; border-radius: 4px; background: transparent; }
        for segment in root.segments: Rectangle { x: 32px + segment.x * 1px; y: 122px; width: segment.width * 1px; height: 24px; border-radius: 4px; border-width: segment.active ? 2px : 0px; border-color: Theme.text; background: segment.tone == 0 ? Theme.fault : segment.tone == 1 ? Theme.thermal : segment.tone == 2 ? Theme.high : segment.tone == 3 ? Theme.low : segment.tone == 4 ? Theme.accent : Theme.faint;
            Label { text: segment.name; font-size: 18px; horizontal-alignment: center; color: segment.tone == 4 ? Theme.bg : #eeeeee; }
            Label { x: 0px; y: 32px; text: segment.value; font-size: 26px; }
        }
        for tile[i] in root.brew-values: Rectangle { x: 32px + mod(i, 3) * 250px; y: 192px + floor(i / 3) * 88px; width: 234px; height: 76px; background: Theme.raised; border-radius: 8px;
            Label { x: 16px; y: 6px; height: 24px; width: 224px; text: tile.name; font-size: 18px; color: Theme.faint; }
            Label { x: 16px; y: 6px; height: 24px; width: 202px; text: tile.aside; font-size: 18px; color: Theme.dim; horizontal-alignment: right; }
            Label { x: 16px; y: 32px; height: 38px; width: 224px; text: tile.value; font-size: 32px; color: mod(i, 3) == 0 ? Theme.full : Theme.text; }
            Label { x: 125px; y: 44px; height: 24px; width: 112px; text: tile.detail; font-size: 18px; color: Theme.faint; }
        }
        if !root.finished: Rectangle { x: 32px; y: 376px; width: 536px; height: 88px; background: Theme.raised; border-radius: 8px;
            for tile[i] in root.live-values: Rectangle { x: i * 134px; width: 134px; height: 88px; background: transparent;
                Label { x: 12px; y: 14px; width: 122px; height: 24px; text: tile.name; font-size: 18px; color: Theme.faint; }
                Label { x: 12px; y: 42px; width: 122px; height: 32px; text: tile.value; }
                if i > 0: Rectangle { y: 16px; width: 1px; height: 56px; background: Theme.hairline; }
            }
        }
        if !root.finished: Key { x: 584px; y: 376px; width: 184px; height: 88px; primary: true; label: "arrêter"; clicked => { root.command(9, ""); } }
        if root.finished: Key { x: 224px; y: 376px; width: 352px; height: 88px; label: root.close-label; enabled: root.close-enabled; clicked => { root.command(9, ""); } }
    }
    if root.page == 2: Rectangle {
        background: transparent;
        Label { y: 120px; height: 40px; width: 800px; text: root.phase; color: Theme.accent; horizontal-alignment: center; }
        Label { y: 170px; height: 120px; width: root.legacy-split ? 399px : 800px; text: root.purge-time; color: Theme.accent; font-size: 104px; horizontal-alignment: center; }
        if root.legacy-split: Label { x: 401px; y: 170px; height: 120px; width: 399px; text: root.legacy-time; color: Theme.accent; font-size: 104px; horizontal-alignment: center; }
        if root.legacy-split: Rectangle { x: 399px; y: 170px; width: 2px; height: 104px; background: Theme.faint; }
        Rectangle { x: 190px; y: 282px; width: 420px; height: 2px; background: Theme.hairline; Rectangle { width: parent.width * root.progress; height: 2px; background: Theme.accent; } }
        Label { y: 304px; height: 48px; width: 800px; text: root.purge-detail; color: Theme.dim; font-size: 40px; horizontal-alignment: center; }
        Key { x: 240px; y: 368px; width: 320px; height: 88px; primary: true; label: root.finished ? root.close-label : "arrêter"; enabled: !root.finished || root.close-enabled; clicked => { root.command(root.phase == "purge" ? 3 : 9, ""); } }
    }
    if root.page >= 3 && root.page <= 6: Rectangle {
        background: transparent;
        Rectangle { y: 0px; height: 88px; background: Theme.raised;
            Back { x: 16px; y: 4px; width: 80px; height: 80px; clicked => { root.command(10, ""); } }
            Label { x: 112px; width: 310px; text: root.page == 3 ? "réglages" : root.page == 4 ? "diagnostic" : root.editor-title; }
            if root.page == 3: Rectangle { background: transparent;
                Key { x: 360px; y: 4px; width: 80px; height: 80px; label: ""; primary: root.wifi-enabled; clicked => { root.command(11, ""); }
                    Path { x: 24px; y: 26px; width: 32px; height: 28px; stroke: root.wifi-enabled ? Theme.text : Theme.faint; stroke-width: 2px; fill: transparent; commands: "M 0 6 Q 16 -4 32 6 M 5 13 Q 16 5 27 13 M 11 20 Q 16 16 21 20 M 15 26 L 17 26"; } }
                for i in 4: Key { x: 536px + i * 64px; y: 12px; width: 56px; height: 64px; label: "" + (i + 1); primary: root.settings-page == i; clicked => { root.command(12, "" + i); } }
            }
            if root.page == 5: Key { x: 640px; y: 4px; width: 160px; height: 80px; primary: true; label: "valider"; clicked => { root.command(15, ""); } }
        }
        if root.page == 3: Rectangle { background: transparent;
            for tile[i] in root.settings: Rectangle { x: mod(i, 2) == 0 ? 32px : 408px; y: 104px + floor(i / 2) * 104px; width: 360px; height: 88px; border-radius: 8px; background: !tile.enabled ? Theme.raised : Theme.surface;
                Label { x: 16px; y: 10px; width: 328px; height: 26px; text: tile.name; font-size: 18px; color: Theme.dim; }
                Label { x: 16px; y: 36px; width: 328px; height: 40px; text: tile.value; color: tile.tone == 2 ? Theme.fault : !tile.enabled ? Theme.faint : Theme.text; }
                TouchArea { enabled: tile.enabled; clicked => { root.command(13, "" + i); } }
            }
        }
        if root.page == 4: Rectangle { background: transparent;
            for tile[i] in root.diagnostics: Rectangle { x: 32px + mod(i, 3) * 248px; y: 104px + floor(i / 3) * 112px; width: 240px; height: 96px; background: transparent;
                Label { height: 24px; width: 240px; text: tile.name; font-size: 18px; color: Theme.faint; }
                Label { y: 28px; height: 32px; width: 240px; text: tile.value; color: tile.tone == 2 ? Theme.fault : Theme.text; }
                Label { y: 62px; height: 24px; width: 240px; text: tile.detail; font-size: 18px; color: tile.tone == 1 ? Theme.accent : Theme.faint; }
                if mod(i, 3) != 2: Rectangle { x: 240px; width: 1px; height: 96px; background: Theme.hairline; }
                if i < 6: Rectangle { y: 96px; width: 240px; height: 1px; background: Theme.hairline; }
                TouchArea { clicked => { root.command(16, "" + i); } }
            }
        }
        if root.page == 5: Rectangle { background: transparent;
            Label { x: 32px; y: 144px; width: 208px; height: 104px; text: root.editor-value; font-size: 76px; }
            Label { x: 200px; y: 190px; width: 48px; height: 38px; text: root.editor-unit; font-size: 32px; color: Theme.dim; }
            Label { x: 32px; y: 286px; width: 208px; height: 80px; text: root.editor-error; wrap: word-wrap; font-size: 18px; color: Theme.fault; }
            for key[i] in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "⌫", "0", ","]: Key { x: 256px + mod(i, 3) * 176px; y: 104px + floor(i / 3) * 96px; width: 160px; height: 80px; label: i == 9 ? "" : key; enabled: i != 11 || root.editor-decimal; clicked => { root.command(14, i == 9 ? "back" : key); }
                if i == 9: Path { x: 58px; y: 26px; width: 42px; height: 28px; stroke: Theme.text; stroke-width: 2px; fill: transparent; commands: "M 12 0 L 42 0 L 42 28 L 12 28 L 0 14 Z M 20 7 L 34 21 M 34 7 L 20 21"; }
            }
        }
        if root.page == 6: Rectangle { background: transparent;
            for tile[i] in root.choices: Key { x: mod(i, 2) == 0 ? 32px : 408px; y: 120px + floor(i / 2) * 112px; width: 360px; height: 88px; label: tile.name; primary: tile.tone == 1; selected-toggle: root.editor-title == "pré-infusion" && tile.tone == 1; clicked => { root.command(17, "" + i); } }
        }
    }
    if root.page == 7: Rectangle { background: Theme.bg;
        Label { x: 32px; y: 64px; height: 50px; width: 736px; text: root.menu-title; font-size: 40px; color: Theme.accent; }
        Label { x: 32px; y: 126px; height: 30px; width: 736px; text: root.menu-body; font-size: 18px; color: Theme.dim; }
        Label { x: 32px; y: 156px; height: 30px; width: 736px; text: root.menu-hint; font-size: 18px; color: Theme.faint; }
        Key { x: 32px; y: 208px; width: 352px; height: 88px; label: root.menu-left; enabled: root.menu-left-enabled; destructive: root.menu-left-destructive; clicked => { root.command(18, "0"); } }
        Key { x: 416px; y: 208px; width: 352px; height: 88px; label: root.menu-right; enabled: root.menu-right-enabled; clicked => { root.command(18, "1"); } }
        Key { x: 224px; y: 328px; width: 352px; height: 88px; label: "fermer"; clicked => { root.command(10, ""); } }
    }
    if root.confirm-visible: Rectangle { background: #16110cb3;
        Rectangle { x: 136px; y: 116px; width: 528px; height: 248px; background: Theme.raised; border-radius: 8px;
            Rectangle { width: 4px; height: 248px; background: Theme.accent; }
            Label { x: 28px; y: 24px; width: 480px; height: 56px; text: root.confirm-title; font-size: 40px; color: Theme.accent; }
            Label { x: 28px; y: 92px; width: 480px; height: 40px; text: root.confirm-body; font-size: 18px; color: Theme.dim; }
            Key { x: 28px; y: 138px; width: 216px; height: 80px; label: "annuler"; clicked => { root.command(19, "0"); } }
            Key { x: 276px; y: 138px; width: 216px; height: 80px; label: "valider"; primary: true; clicked => { root.command(19, "1"); } }
        }
    }
    if root.full-visible: Rectangle { background: Theme.bg;
        Label { x: 32px; y: 154px; width: 736px; height: 56px; text: root.full-title; font-size: 40px; color: root.full-fault ? Theme.fault : Theme.accent; }
        Label { x: 32px; y: 220px; width: 736px; height: 140px; text: root.full-body; wrap: word-wrap; color: Theme.dim; }
        if root.full-progress: Rectangle { x: 32px; y: 380px; width: 736px; height: 2px; background: Theme.hairline; Rectangle { width: parent.width * root.progress; height: 2px; background: Theme.accent; } }
        TouchArea {}
    }
    if root.dimmed: Rectangle { background: root.standby ? Theme.bg : #16110c99;
        if root.standby: Label { x: 270px + root.standby-offset * 1px; y: 194px + root.standby-offset / 3 * 1px; width: 260px; height: 92px; text: "coffeeflow"; font-size: 40px; color: Theme.low; }
        if root.standby: Label { x: 362px + root.standby-offset * 1px; y: 252px + root.standby-offset / 3 * 1px; width: 200px; height: 30px; text: "au repos"; font-size: 18px; color: Theme.faint; }
        TouchArea { pointer-event(event) => { if event.kind == PointerEventKind.up { root.command(20, ""); } } }
    }
}
