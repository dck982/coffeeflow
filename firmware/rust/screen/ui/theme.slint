// Les teintes viennent de l'écran archivé, y compris les états de diagnostic.
export global Theme {
    out property <color> bg: #16110C;
    out property <color> raised: #241B14;
    out property <color> surface: #33271E;
    out property <color> high: #453426;
    out property <color> primary: #4A2E16;
    out property <color> hairline: #332C28;
    out property <color> text: #F2EBE3;
    out property <color> dim: #A2968C;
    out property <color> faint: #6B615A;
    out property <color> accent: #D98324;
    out property <color> thermal: #4A9BB5;
    out property <color> near: #849B82;
    out property <color> ambient: #A485D0;
    out property <color> fault: #B9412F;
    out property <color> success: #4CAF50;
    out property <color> low: #8C5A22;
    out property <color> full: #F2B25C;
}
