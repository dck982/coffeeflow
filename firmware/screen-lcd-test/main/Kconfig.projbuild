menu "LCD / radio diagnostic"

choice LCD_TEST_BOOT_SEQUENCE
    prompt "Sequence de demarrage testee"
    default LCD_TEST_LCD_WIFI_NIMBLE

config LCD_TEST_LCD_ONLY
    bool "LCD / LVGL seulement"

config LCD_TEST_LCD_WIFI
    bool "LCD / LVGL puis Wi-Fi + HTTP"

config LCD_TEST_LCD_NIMBLE
    bool "LCD / LVGL puis NimBLE"

config LCD_TEST_LCD_WIFI_NIMBLE
    bool "LCD / LVGL puis Wi-Fi + HTTP puis NimBLE"

config LCD_TEST_SWITCH_WIFI_NIMBLE
    bool "LCD / LVGL puis Wi-Fi <-> NimBLE toutes les 5 secondes"

endchoice
endmenu
