# Défauts de projet — sonde XDB401 (M5Stack Core2, ESP32, flash 16 Mo,
# PSRAM 8 Mo). Complète la config par défaut d'ESP-IDF v6.1.

CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Le tampon d'écran 320 × 240 en 16 bits (150 ko) vit en PSRAM.
CONFIG_SPIRAM=y

CONFIG_FREERTOS_HZ=1000

# Serveur GATT de la sonde, comme SCACE : NimBLE, rôle périphérique seul.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
