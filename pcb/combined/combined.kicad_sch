	(label "TACHO_P"
		(at 125.73 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bf19d084-2cdb-45c5-8f64-fb053489af35")
	)
	(text "GND_P, +5V_P, SPEED_P and TACHO_P belong to the pump (green, yellow, brown, blue wires):\nnever tie them to board GND or +5V. Rotation (white) stays unconnected in the cable.\nU8 off (reset, boot, XIAO absent): R35 pulls the setpoint to GND_P, pump stopped.\nPWM 1 kHz, 16 bits on GPIO1; 2 x 2.2k / 1.5uF filter: 48 Hz, about 12 mV ripple, 10 ms response.\nPUMP_TACHO is low while blue is low; count its edges (PCNT)."
		(exclude_from_sim no)
		(at 20 158 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f75a7bd1-89b0-436e-8740-cfb8f8eec64f")
	)
