	(text "2. ESP32-S3-MINI-1U-N8 - CAN only, no antenna fitted"
		(exclude_from_sim no)
		(at 225 15 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left top)
		)
		(uuid "23dd1871-35e7-5e10-88fb-a18fdc95b346")
	)
	(text "GPIO45/46 low: 3.3V flash / download strap. GPIO3 unused.\nHold BOOT, tap RESET, release BOOT for ROM USB download.\nMINI-1U body: 15.4 x 15.4mm. Wi-Fi and BLE disabled in firmware."
		(exclude_from_sim no)
		(at 225 179 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "4a30128e-f672-59c7-9e07-dc92bd5003ce")
	)
	(text "USB flashing: disconnect J1 power, then connect Mac USB-C.\nProduction: unplug USB-C, then connect J1 to RECOM 5V.\nBoth feed the same +5V rail; no power OR-ing or reverse blocking."
		(exclude_from_sim no)
		(at 18 245 0)
		(effects
			(font
				(size 1.2 1.2)
			)
			(justify left top)
		)
		(uuid "544a3d6c-1aec-511b-afac-728e0b0eab05")
	)
	(text "1. POWER - XH for production OR USB-C for flashing"
		(exclude_from_sim no)
		(at 18 15 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left top)
		)
		(uuid "5da658fe-0dba-57d0-b489-9229aa5909d0")
	)
	(text "C3: solid tantalum for AMS1117 stability.\nProvide copper heatsinking: 0.85W at 500mA; verify enclosure temperature.\nUSB VBUS and J1 feed +5V: NEVER connect both power sources."
		(exclude_from_sim no)
		(at 18 106 0)
		(effects
			(font
				(size 1.25 1.25)
			)
			(justify left top)
		)
		(uuid "682b5068-628d-5ee0-853d-e0ec76df089f")
	)
	(text "3. USB-C - flashing and power; disconnect XH power before connecting USB"
		(exclude_from_sim no)
		(at 18 147 0)
		(effects
			(font
				(size 1.7 1.7)
			)
			(justify left top)
		)
		(uuid "8f3b3841-cd79-54bf-9f0c-e73513d32b2c")
	)
	(text "ESP32 provides its USB data pull-up internally. CC1/CC2: 5.1k to GND.\nRoute USB as a 90-ohm pair; D1 at J2, R6/R7 at U1.\nC1: 4.7uF input bulk to reduce USB plug-in inrush."
		(exclude_from_sim no)
		(at 18 265 0)
		(effects
			(font
				(size 1.1 1.1)
			)
			(justify left top)
		)
		(uuid "f68928c1-378f-5336-97ed-1958d87d7bf0")
	)
